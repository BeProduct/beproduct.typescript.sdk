# BeProduct SDK — integration test credentials
# Copy to `.env` (gitignored) and fill in real values to run integration tests.
# Required when BEPRODUCT_INTEGRATION=1 is set.

BEPRODUCT_CLIENT_ID=
BEPRODUCT_CLIENT_SECRET=
BEPRODUCT_REFRESH_TOKEN=
BEPRODUCT_COMPANY_DOMAIN=ltd3

# Set to 1 to enable integration tests (they're skipped by default)
# BEPRODUCT_INTEGRATION=1

# ── Golden-comparison parity suites ──
# attributes/apps/upload integration tests assert live responses against golden
# fixtures in tests/integration/fixtures/<BEPRODUCT_COMPANY_DOMAIN>/ (gitignored).
# Point BEPRODUCT_COMPANY_DOMAIN at a tenant that has a matching fixtures dir
# (e.g. integration_autotest). Suites auto-skip when no fixtures dir exists for
# the active domain, so a fresh clone with no fixtures still passes.
